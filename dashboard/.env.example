# Base URL of the FastAPI gateway. The dashboard calls /v1/stats,
# /v1/stats/trend and /v1/stats/top-cached on this host.
# NEXT_PUBLIC_ means it is inlined at build time. It is only ever used by the
# server-side route handler and for display, so it must be a URL that Next's
# server can reach.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000

# Read-only dashboard token for the tenant this deployment shows. Scoped to
# /v1/stats* only — it cannot call the proxy route, so it cannot spend money.
#
# Deliberately NOT prefixed with NEXT_PUBLIC_: it is read at request time by
# app/gateway/[...path]/route.ts and attached server-side, so it never reaches
# the browser. Adding the prefix would publish it in the page bundle.
#
# There is no tenant id to configure — the gateway derives the tenant from this
# token. Point it at a different tenant's token to see a different tenant.
# Issue one with `python ../scripts/migrate_hash_keys.py --mode=in-place`; for the
# local demo data, scripts/seed_demo.py prints `dash_demo-tenant-token`.
GATEWAY_DASHBOARD_TOKEN=dash_demo-tenant-token
