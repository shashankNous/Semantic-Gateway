# Base URL of the FastAPI gateway. The dashboard calls /v1/stats,
# /v1/stats/trend and /v1/stats/top-cached on this host.
# NEXT_PUBLIC_ means it is inlined at build time and read in the browser,
# so it must be a URL the browser can reach — not a docker-internal hostname.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000

# Which tenant the dashboard loads on first paint. Editable in the UI.
NEXT_PUBLIC_TENANT_ID=1
