# Local testing against Ollama. Copy to .env.local (gitignored):
#
#   cp .env.local.example .env.local
#
# Read only by scripts/local_setup.py, scripts/run_local_gateway.py and
# scripts/local_smoke_test.py, which also disable the app's normal .env lookup so
# nothing from your real .env leaks in. Every URL must point at this machine.
# Production uses .env.example; none of these values belong there.

# --- Completions: Ollama's OpenAI-compatible API ------------------------------
# The gateway runs on the host, so localhost reaches Ollama. If you run the gateway
# inside Docker instead, use http://host.docker.internal:11434/v1 for both URLs.
UPSTREAM_BASE_URL=http://localhost:11434/v1
# Smallest capable chat model installed (phi3 is 2.2 GB; gemma4:e2b is 7.2 GB).
UPSTREAM_MODEL=phi3:latest
# Ollama ignores the key, but the proxy refuses to start a request without one.
MISTRAL_API_KEY=ollama-dummy-key

# --- Embeddings: Ollama, same API shape as OpenAI ------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
# Verified by calling the model: nomic-embed-text returns 768 dimensions.
# scripts/local_setup.py re-checks this against the live model before migrating.
EMBEDDING_DIM=768
EMBEDDING_API_KEY=ollama-dummy-key
# Shadows any real key, so it can never be sent anywhere from a local run.
OPENAI_API_KEY=ollama-dummy-key

# --- Semantic cache ------------------------------------------------------------
# LOCAL TESTING ONLY. nomic-embed-text scores differently from OpenAI's model:
# rewordings land around 0.97, unrelated prompts around 0.3-0.4, and the smoke
# test's near-miss pairs (enable/disable, Delhi/Mumbai, v2/v3) at 0.81-0.93. 0.80
# lets those near-misses through to match verification, which is what the smoke
# test needs to exercise. Production stays at 0.92.
SEMANTIC_CACHE_THRESHOLD=0.80

# --- Local stack (docker-compose.local.yml) ------------------------------------
DATABASE_URL=postgresql://postgres:localtest@localhost:55432/semanticdb
REDIS_URL=redis://localhost:56379/0
CACHE_TTL_SECONDS=86400

# --- Everything else the app reads, pinned so nothing falls through ------------
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_FAIL_MODE=closed
COST_PER_1K_TOKENS=0.002
DASHBOARD_ORIGIN=

# Port the local gateway listens on (8000 is used by docker-compose.yml).
LOCAL_GATEWAY_PORT=8010
