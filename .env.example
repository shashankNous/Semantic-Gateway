# Upstream LLM (Mistral) used to answer cache misses
MISTRAL_API_KEY=your-mistral-api-key
UPSTREAM_BASE_URL=https://api.mistral.ai/v1
UPSTREAM_MODEL=mistral-small-latest

# Embeddings for the semantic cache.
#
# !! NEVER MIX EMBEDDING MODELS WITHIN ONE TENANT. Vectors from different models
# !! are not comparable even when they fit the same column, and nothing detects
# !! it: matches just become meaningless. Changing EMBEDDING_PROVIDER or
# !! EMBEDDING_MODEL means a fresh tenant, or clearing that tenant's cache_entries.
#
# EMBEDDING_PROVIDER is an optional preset of defaults. Unset means openai.
#   openai  - api.openai.com, OPENAI_API_KEY,  text-embedding-3-small, 1536 wide
#   mistral - api.mistral.ai, MISTRAL_API_KEY, mistral-embed,          1024 wide
# Anything else stops the app at startup.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
#
# Optional overrides; each replaces one preset default. Production sets none.
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=            # else the preset's key variable above
# EMBEDDING_MODEL=text-embedding-3-small
#
# Two widths. EMBEDDING_DIM is the cache_entries.embedding column (vector(1536));
# EMBEDDING_NATIVE_DIM is what the model returns (else the preset's, else
# EMBEDDING_DIM). A narrower model is zero-padded up to the column, which leaves
# cosine similarity exactly unchanged: mistral-embed's 1024 fit vector(1536). A
# wider one stops the app at startup. Every response is checked against the
# native width; a mismatch degrades that request to a plain miss. The old name
# EMBEDDING_DIMS is refused at startup.
# EMBEDDING_DIM=1536
# EMBEDDING_NATIVE_DIM=
# EMBEDDING_TIMEOUT_SECONDS=10  # then the request degrades to a plain miss

# Redis (exact-match cache)
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=86400

# Postgres (request logging + pgvector semantic cache)
# POSTGRES_PASSWORD is consumed directly by docker-compose.yml to configure the postgres container.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/semanticdb

# Semantic cache
SEMANTIC_CACHE_THRESHOLD=0.92

# Stats endpoint cost estimation
COST_PER_1K_TOKENS=0.002

# Per-tenant throttle on /v1/chat/completions, counted in Redis. Both are read at
# import time by app/services/rate_limit.py, so either can be tuned per partner
# without a code change.
#   RATE_LIMIT_PER_MINUTE    requests allowed per window. Set to 0 to disable.
#                            Named for the default window; it is really per-window.
#   RATE_LIMIT_WINDOW_SECONDS  length of that window, and the Retry-After value sent
#                            on both the 429 and the fail-closed 503 below.
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_WINDOW_SECONDS=60

# What to do when Redis is unreachable and the cap cannot be enforced:
#   closed - reject with 503. The cap holds; the proxy is down while Redis is.
#   open   - serve uncapped. Stays up, but every tenant is unthrottled.
# Default is closed: an unthrottled window sends uncapped traffic upstream at
# real cost per request. Any other value is a startup error, not a fallback.
RATE_LIMIT_FAIL_MODE=closed

# Browser origin(s) allowed to read /v1/stats* cross-origin, comma-separated.
# Leave unset to allow none — the dashboard proxies through its own server and
# does not need this. Only set it if a browser calls the gateway directly.
# DASHBOARD_ORIGIN=https://your-dashboard.vercel.app
